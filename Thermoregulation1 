    // --- SECTION 2: THERMAL TISSUE GRID ---
    public static class ThermalTissueGrid {
        private final int width;
        private final int height;
        private final double[][] temperatureGrid;

        public ThermalTissueGrid(int width, int height, double initialTemp) {
            this.width = width;
            this.height = height;
            this.temperatureGrid = new double[width][height];
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    temperatureGrid[x][y] = initialTemp;
                }
            }
        }

        public synchronized void simulateThermalFlux(double ambientTemp, double coolingEffectorPower) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    double diff = ambientTemp - temperatureGrid[x][y];
                    temperatureGrid[x][y] += diff * 0.05 - (coolingEffectorPower * 0.02);
                }
            }
        }

        public synchronized double getAverageTemperature() {
            double sum = 0;
            int count = width * height;
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    sum += temperatureGrid[x][y];
                }
            }
            return sum / count;
        }
    }

    // --- SECTION 3: THERMAL FEEDBACK CONTROLLER ---
    public static class ThermalFeedbackController {
        private final ComprehensiveThermoregulationSystem system;
        public ThermalFeedbackController(ComprehensiveThermoregulationSystem system) {
            this.system = system;
        }

        public void processThermalTelemetry(ThermalTelemetry telemetry, BesuLedgerAnchor ledgerAnchor) {
            system.getHypothalamus().updateCoreTemperature(telemetry.getCoreTemperature());
            double error = system.getHypothalamus().getThermalError();

            if (error > 0.3) {
                system.getVascular().setVasomotorState("VASODILATED");
                system.getMuscular().setShiveringActive(false);
                system.getEndocrine().setMetabolicMultiplier(0.90);
                System.out.println("[THERMO-COOL] Error: " + error + "°C | Action: VASODILATION & SWEATING ACTIVATED");
                if (ledgerAnchor != null) {
                    ledgerAnchor.anchorState("THERMAL_COOLING_ACTIVATED", telemetry.getTimestamp());
                }
            } else if (error < -0.3) {
                system.getVascular().setVasomotorState("VASOCONSTRICTED");
                system.getMuscular().setShiveringActive(true);
                system.getEndocrine().setMetabolicMultiplier(1.25);
                System.out.println("[THERMO-WARM] Error: " + error + "°C | Action: VASOCONSTRICTION & SHIVERING ACTIVATED");
                if (ledgerAnchor != null) {
                    ledgerAnchor.anchorState("THERMAL_WARMING_ACTIVATED", telemetry.getTimestamp());
                }
            } else {
                system.getVascular().setVasomotorState("NEUTRAL");
                system.getMuscular().setShiveringActive(false);
                system.getEndocrine().setMetabolicMultiplier(1.0);
                System.out.println("[HOMEOSTASIS] Core temperature stable at " + telemetry.getCoreTemperature() + "°C");
            }
            system.evaluateHomeostasis(error);
        }
    }

    // --- SECTION 4: HIGH-FREQUENCY 6 KHZ PROCESSING ENGINE ---
    public static class HighFrequencyThermodynamicEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;

        private final BlockingQueue<ThermalTelemetry> telemetryQueue = new LinkedBlockingQueue<>();
        private final ComprehensiveThermoregulationSystem thermoregulationSystem;
        private final ThermalTissueGrid tissueGrid;
        private final ThermalFeedbackController feedbackController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyThermodynamicEngine(int gridWidth, int gridHeight, String besuRpcEndpoint) {
            this.thermoregulationSystem = new ComprehensiveThermoregulationSystem();
            this.tissueGrid = new ThermalTissueGrid(gridWidth, gridHeight, 37.0);
            this.feedbackController = new ThermalFeedbackController(thermoregulationSystem);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestTelemetry(ThermalTelemetry telemetry) {
            telemetryQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-Thermodynamic-Engine");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) {
                processingThread.interrupt();
            }
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;

            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();
                    tickCounter++;

                    if (tickCounter % 6000 == 0) {
                        double coolingPower = thermoregulationSystem.getVascular().getState().equals("VASODILATED") ? 1.0 : 0.0;
                        tissueGrid.simulateThermalFlux(25.0, coolingPower);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            ThermalTelemetry telemetry = telemetryQueue.poll();
            if (telemetry != null) {
                feedbackController.processThermalTelemetry(telemetry, ledgerAnchor);
            }
        }

        public ComprehensiveThermoregulationSystem getThermoregulationSystem() { return thermoregulationSystem; }
    }

    public static class ThermalTelemetry {
        private final long timestamp;
        private final double coreTemperature;
        private final double skinTemperature;
        public ThermalTelemetry(long timestamp, double coreTemperature, double skinTemperature) {
            this.timestamp = timestamp;
            this.coreTemperature = coreTemperature;
            this.skinTemperature = skinTemperature;
        }
        public long getTimestamp() { return timestamp; }
        public double getCoreTemperature() { return coreTemperature; }
        public double getSkinTemperature() { return skinTemperature; }
    }

