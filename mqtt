Alternative: Standard WebSockets (JDK 11+)
If you prefer WebSockets over raw TCP, modern Java includes a native WebSocket client built
right into the standard library (java.net.http.WebSocket), requiring zero dependencies:
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.WebSocket;
import java.util.concurrent.CompletionStage;
public class ScopeWebSocketClient {
public static void main(String[] args) {
HttpClient client = HttpClient.newHttpClient();
WebSocket.Listener listener = new WebSocket.Listener() {
@Override
public CompletionStage<?> onText(WebSocket webSocket,
CharSequence data, boolean last) {
System.out.println("Received WebSocket message: " +
data);
webSocket.request(1);
return WebSocket.Listener.super.onText(webSocket,
data, last);
}
};
client.newWebSocketBuilder()
.buildAsync(URI.create("ws://echo.websocket.events"),
listener)


.thenAccept(webSocket -> {
String topicPayload =
"system/downtown/hospital-alpha/events/fire-alarm|{\"status\":\"active
\"}";
webSocket.sendText(topicPayload, true);
System.out.println("Sent scope over WebSocket.");
});
try { Thread.sleep(3000); } catch (InterruptedException
ignored) {}
}
}


