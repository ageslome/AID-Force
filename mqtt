Implementing a custom publish-subscribe messaging system using standard Java TCP
sockets (java.net.*) allows you to build a lightweight, dependency-free broker and client
architecture tailored specifically to your scope hierarchy
(system/{area}/{structure}/{category}/{entityId}/{action}) without any third-party IoT bloat.
1. The Lightweight TCP Scope Broker
This server listens on a TCP port, accepts multiple client connections, and broadcasts
messages formatted as TOPIC|PAYLOAD to all connected clients.
import java.io.*;
import java.net.*;
import java.util.*;
import java.util.concurrent.*;
public class ScopeTcpBroker {
private static final int PORT = 18883;
private static final Set<PrintWriter> clientWriters =
ConcurrentHashMap.newKeySet();
public static void main(String[] args) {
System.out.println("Starting Scope TCP Broker on port " + PORT
+ "...");
try (ServerSocket serverSocket = new ServerSocket(PORT)) {
while (true) {
Socket socket = serverSocket.accept();
new Thread(new ClientHandler(socket)).start();
}
} catch (IOException e) {
e.printStackTrace();
}
}
private static class ClientHandler implements Runnable {
private final Socket socket;
private PrintWriter out;
public ClientHandler(Socket socket) {
this.socket = socket;
}
@Override
public void run() {
try (
BufferedReader in = new BufferedReader(new
InputStreamReader(socket.getInputStream()))
) {
out = new PrintWriter(socket.getOutputStream(), true);
clientWriters.add(out);



System.out.println("[BROKER] New client connected: " +
socket.getRemoteSocketAddress());
String inputLine;
while ((inputLine = in.readLine()) != null) {
// Expected message format: TOPIC|PAYLOAD
String[] parts = inputLine.split("\\|", 2);
if (parts.length == 2) {
String topic = parts[0];
String payload = parts[1];
System.out.println("[BROKER] Routing Topic: "
+ topic);
broadcast(inputLine, out); // Broadcast to
other clients
}
}
} catch (IOException e) {
System.out.println("[BROKER] Client disconnected.");
} finally {
if (out != null) {
clientWriters.remove(out);
}
try {
socket.close();
} catch (IOException ignored) {}
}
}
private void broadcast(String message, PrintWriter senderOut)
{
for (PrintWriter writer : clientWriters) {
if (writer != senderOut) { // Echo to others
writer.println(message);
}
}
}
}
}
2. The TCP Scope Client
This client connects directly via standard sockets to publish events and listen for scoped
updates matching your architecture.
import java.io.*;
import java.net.*;


public class ScopeTcpClient {
public static void main(String[] args) {
String host = "127.0.0.1";
int port = 18883;
try {
Socket socket = new Socket(host, port);
BufferedReader in = new BufferedReader(new
InputStreamReader(socket.getInputStream()));
PrintWriter out = new
PrintWriter(socket.getOutputStream(), true);
System.out.println("Connected to Scope TCP Broker.");
// Start a background thread to listen for incoming scoped
messages
new Thread(() -> {
try {
String response;
while ((response = in.readLine()) != null) {
String[] parts = response.split("\\|", 2);
if (parts.length == 2) {
String topic = parts[0];
String payload = parts[1];
parseScope(topic, payload);
}
}
} catch (IOException e) {
System.out.println("Connection closed.");
}
}).start();
// Publish a sample scoped event matching your taxonomy
// Structure:
system/{area}/{structure}/{category}/{entityId}/{action}
String topic =
"system/downtown/hospital-alpha/events/fire-alarm";
String payload = "{\"status\": \"active\", \"severity\":
\"high\"}";
System.out.println("Publishing to scope: " + topic);
out.println(topic + "|" + payload);
// Keep alive to listen for reflections/messages
Thread.sleep(4000);
socket.close();
} catch (Exception e) {


e.printStackTrace();
}
}
private static void parseScope(String topic, String payload) {
System.out.println("\n[CLIENT RECEIVED]");
System.out.println(" -> Full Topic: " + topic);
System.out.println(" -> Payload: " + payload);
String[] segments = topic.split("/");
if (segments.length >= 6) {
System.out.printf(" Parsed -> Area: %s | Structure: %s |
Category: %s | ID: %s | Action: %s%n",
segments[1], segments[2], segments[3],
segments[4], segments[5]);
}
}
}
Alternative: Standard WebSockets (JDK 11+)
If you prefer WebSockets over raw TCP, modern Java includes a native WebSocket client built
right into the standard library (java.net.http.WebSocket), requiring zero dependencies:
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.WebSocket;
import java.util.concurrent.CompletionStage;
public class ScopeWebSocketClient {
public static void main(String[] args) {
HttpClient client = HttpClient.newHttpClient();
WebSocket.Listener listener = new WebSocket.Listener() {
@Override
public CompletionStage<?> onText(WebSocket webSocket,
CharSequence data, boolean last) {
System.out.println("Received WebSocket message: " +
data);
webSocket.request(1);
return WebSocket.Listener.super.onText(webSocket,
data, last);
}
};
client.newWebSocketBuilder()
.buildAsync(URI.create("ws://echo.websocket.events"),
listener)


.thenAccept(webSocket -> {
String topicPayload =
"system/downtown/hospital-alpha/events/fire-alarm|{\"status\":\"active
\"}";
webSocket.sendText(topicPayload, true);
System.out.println("Sent scope over WebSocket.");
});
try { Thread.sleep(3000); } catch (InterruptedException
ignored) {}
}
}


