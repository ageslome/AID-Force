    // --- SECTION 4: DERMAL MALIGNANCY & TISSUE MATRIX ---
    public static class DermalTissueGrid {
        private final int width;
        private final int height;
        private final CellState[][] grid;
        private final double[][] lesionFactor;

        public enum CellState {
            HEALTHY_DERMAL,
            MELANOMA_ACTIVE,
            NECROTIC_TISSUE,
            PROTECTION_APPLIED
        }

        public DermalTissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new CellState[width][height];
            this.lesionFactor = new double[width][height];
            initializeTissue();
        }

        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = CellState.HEALTHY_DERMAL;
                    lesionFactor[x][y] = 0.10 + (rand.nextDouble() * 0.08);
                }
            }
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = CellState.MELANOMA_ACTIVE;
            lesionFactor[cx][cy] = 0.55;
        }

        public synchronized void simulateMacroStep(double uvExposureMultiplier) {
            CellState[][] nextState = new CellState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            Random rand = new Random();
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == CellState.MELANOMA_ACTIVE) {
                        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
                        for (int[] dir : directions) {
                            int nx = x + dir[0];
                            int ny = y + dir[1];
                            if (grid[nx][ny] == CellState.HEALTHY_DERMAL) {
                                double adjustedFactor = lesionFactor[nx][ny] * uvExposureMultiplier;
                                if (rand.nextDouble() < adjustedFactor) {
                                    nextState[nx][ny] = CellState.MELANOMA_ACTIVE;
                                }
                            }
                        }
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }

        public synchronized void applyTherapeuticIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if (grid[x][y] == CellState.MELANOMA_ACTIVE && intensityLevel > 0) {
                        grid[x][y] = CellState.PROTECTION_APPLIED;
                        intensityLevel--;
                    } else if (grid[x][y] == CellState.PROTECTION_APPLIED) {
                        grid[x][y] = CellState.NECROTIC_TISSUE;
                    }
                }
            }
        }
    }

    // --- SECTION 5: HIGH-FREQUENCY 6 KHZ PROCESSING & LEDGER ANCHORING ---
    public static class HighFrequencyIntegumentaryEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;

        private final BlockingQueue<CutaneousTelemetry> sensorQueue = new LinkedBlockingQueue<>();
        private final DermalTissueGrid tissueGrid;
        private final ProtectionaryFeedbackController feedbackController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyIntegumentaryEngine(int gridWidth, int gridHeight, double baselineUV, String besuRpcEndpoint) {
            this.tissueGrid = new DermalTissueGrid(gridWidth, gridHeight);
            this.feedbackController = new ProtectionaryFeedbackController(baselineUV);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestSensorData(CutaneousTelemetry telemetry) {
            sensorQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-Integumentary-Engine-V1");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) {
                processingThread.interrupt();
            }
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;
            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();

                    tickCounter++;
                    if (tickCounter % 6000 == 0) {
                        tissueGrid.simulateMacroStep(1.15);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            CutaneousTelemetry telemetry = sensorQueue.poll();
            if (telemetry != null) {
                feedbackController.processTelemetryStream(telemetry.getSkinTemperature(), telemetry.getUvIndex());
                if (telemetry.getUvIndex() > 0.85 || telemetry.getSkinTemperature() > 39.0) {
                    tissueGrid.applyTherapeuticIntervention(3);
                    ledgerAnchor.anchorState("INTEGUMENTARY_ANOMALY_MITIGATION_V1", telemetry.getTimestamp());
                }
            }
        }
    }

