    }
    public static class TissueGrid {
        private final int width;
        private final int height;
        private final CellState[][] grid;
        private final double[][] proliferationFactor;
        public TissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new CellState[width][height];
            this.proliferationFactor = new double[width][height];
            initializeTissue();
        }
        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = CellState.HEALTHY_NEURAL;
                    proliferationFactor[x][y] = 0.15 + (rand.nextDouble() * 0.10);
                }
            }
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = CellState.TUMOR_ACTIVE;
            proliferationFactor[cx][cy] = 0.65;
        }
        public synchronized void simulateStep() {
            CellState[][] nextState = new CellState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == CellState.TUMOR_ACTIVE) {
                        spreadOrMutate(x, y, nextState);
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }
        private void spreadOrMutate(int x, int y, CellState[][] targetGrid) {
            Random rand = new Random();
            int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
            for (int[] dir : directions) {
                int nx = x + dir[0];
                int ny = y + dir[1];
                if (grid[nx][ny] == CellState.HEALTHY_NEURAL) {
                    if (rand.nextDouble() < proliferationFactor[nx][ny]) {
                        targetGrid[nx][ny] = CellState.TUMOR_ACTIVE;
                    }
                }
            }
        }
        public synchronized void applyTherapeuticIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if (grid[x][y] == CellState.TUMOR_ACTIVE && intensityLevel > 0) {
                        grid[x][y] = CellState.THERAPY_APPLIED;
                        intensityLevel--;
                    } else if (grid[x][y] == CellState.THERAPY_APPLIED) {
                        grid[x][y] = CellState.TUMOR_NECROTIC;
                    }
                }
            }
        }
        public void printGridState() {
            for (int y = 0; y < height; y++) {
                for (int x = 0; x < width; x++) {
                    switch (grid[x][y]) {
                        case HEALTHY_NEURAL: System.out.print(". "); break;
                        case TUMOR_ACTIVE: System.out.print("O "); break;
                        case TUMOR_NECROTIC: System.out.print("x "); break;
                        case THERAPY_APPLIED: System.out.print("* "); break;
                    }
                }
                System.out.println();
            }
            System.out.println("----------------------------------------");
        }
    }
}

