    // --- SECTION 3: GASTROINTESTINAL FEEDBACK CONTROLLER ---
    public static class DigestiveFeedbackController {
        private final double baselineSecretionIndex;
        private double currentGastricLoad;
        private boolean feedbackActive = true;

        public DigestiveFeedbackController(double baselineSecretionIndex) {
            this.baselineSecretionIndex = baselineSecretionIndex;
        }

        public void processTelemetryStream(double latestGastricLoad) {
            if (!feedbackActive) return;
            this.currentGastricLoad = latestGastricLoad;
            double homeostaticError = currentGastricLoad - baselineSecretionIndex;
            evaluateFeedbackLoop(homeostaticError);
        }

        private void evaluateFeedbackLoop(double error) {
            if (error > 0.25) {
                dispatchEfferentSignal(
                    "PARASYMPATHETIC_STIMULATION", 
                    "Increase vagal tone to enhance motility and enzymatic output."
                );
            } else if (error < -0.25) {
                dispatchEfferentSignal(
                    "SYMPATHETIC_INHIBITION", 
                    "Suppress gastrointestinal motility during stress response."
                );
            } else {
                System.out.println("[HOMEOSTASIS] Digestive secretion and motility stable within tolerance.");
            }
        }

        private void dispatchEfferentSignal(String actionType, String directive) {
            System.out.println("[EFFERENT DISPATCH] Action: " + actionType + " | Directive: " + directive);
        }

        public void setFeedbackActive(boolean active) {
            this.feedbackActive = active;
        }
    }

    // --- SECTION 4: GASTROINTESTINAL PATHOLOGY & TISSUE MATRIX ---
    public static class DigestiveTissueGrid {
        private final int width;
        private final int height;
        private final CellState[][] grid;
        private final double[][] inflammationFactor;

        public enum CellState {
            HEALTHY_MUCOSA,
            ULCER_ACTIVE,
            ULCER_NECROTIC,
            THERAPY_APPLIED
        }

        public DigestiveTissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new CellState[width][height];
            this.inflammationFactor = new double[width][height];
            initializeTissue();
        }

        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = CellState.HEALTHY_MUCOSA;
                    inflammationFactor[x][y] = 0.10 + (rand.nextDouble() * 0.10);
                }
            }
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = CellState.ULCER_ACTIVE;
            inflammationFactor[cx][cy] = 0.70;
        }

        public synchronized void simulateMacroStep(double systemicStressMultiplier) {
            CellState[][] nextState = new CellState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            Random rand = new Random();
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == CellState.ULCER_ACTIVE) {
                        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
                        for (int[] dir : directions) {
                            int nx = x + dir[0];
                            int ny = y + dir[1];
                            if (grid[nx][ny] == CellState.HEALTHY_MUCOSA) {
                                double adjustedFactor = inflammationFactor[nx][ny] * systemicStressMultiplier;
                                if (rand.nextDouble() < adjustedFactor) {
                                    nextState[nx][ny] = CellState.ULCER_ACTIVE;
                                }
                            }
                        }
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }

        public synchronized void applyTherapeuticIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if (grid[x][y] == CellState.ULCER_ACTIVE && intensityLevel > 0) {
                        grid[x][y] = CellState.THERAPY_APPLIED;
                        intensityLevel--;
                    } else if (grid[x][y] == CellState.THERAPY_APPLIED) {
                        grid[x][y] = CellState.ULCER_NECROTIC;
                    }
                }
            }
        }
    }

    // --- SECTION 5: HIGH-FREQUENCY 6 KHZ PROCESSING & LEDGER ANCHORING ---
    public static class HighFrequencyDigestiveEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;
        
        private final BlockingQueue<SensorTelemetry> sensorQueue = new LinkedBlockingQueue<>();
        private final DigestiveTissueGrid tissueGrid;
        private final DigestiveFeedbackController feedbackController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyDigestiveEngine(int gridWidth, int gridHeight, double baselineStress, String besuRpcEndpoint) {
            this.tissueGrid = new DigestiveTissueGrid(gridWidth, gridHeight);
            this.feedbackController = new DigestiveFeedbackController(baselineStress);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestSensorData(SensorTelemetry telemetry) {
            sensorQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-Digestive-Engine-V1");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) {
                processingThread.interrupt();
            }
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;
            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();
                    
                    tickCounter++;
                    if (tickCounter % 6000 == 0) {
                        tissueGrid.simulateMacroStep(1.1);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            SensorTelemetry telemetry = sensorQueue.poll();
            if (telemetry != null) {
                feedbackController.processTelemetryStream(telemetry.getGastricLoad());
                if (telemetry.getGastricLoad() > 0.85) {
                    tissueGrid.applyTherapeuticIntervention(3);
                    ledgerAnchor.anchorState("DIGESTIVE_ANOMALY_MITIGATION_V1", telemetry.getTimestamp());
                }
            }
        }
    }

