    /**
     * Represents the biochemical signaling protein network (Interleukins, Interferons, TNFs, Chemokines).
     */
    public static class CytokineNetwork {
        private double il6Level;        // Core driver for Cytokine Release Syndrome (CRS)
        private double tnfAlphaLevel;   // Systemic inflammation and apoptosis driver
        private double il1BetaLevel;    // Refractory neurotoxicity and inflammasome driver
        private double ifnGammaLevel;   // Macrophage activation marker

        public CytokineNetwork(double il6, double tnf, double il1, double ifn) {
            this.il6Level = il6;
            this.tnfAlphaLevel = tnf;
            this.il1BetaLevel = il1;
            this.ifnGammaLevel = ifn;
        }

        public void updateLevels(double deltaIl6, double deltaTnf, double deltaIl1, double deltaIfn) {
            this.il6Level = Math.max(0.0, this.il6Level + deltaIl6);
            this.tnfAlphaLevel = Math.max(0.0, this.tnfAlphaLevel + deltaTnf);
            this.il1BetaLevel = Math.max(0.0, this.il1BetaLevel + deltaIl1);
            this.ifnGammaLevel = Math.max(0.0, this.ifnGammaLevel + deltaIfn);
        }

        public double getTotalProInflammatoryBurden() {
            return il6Level + tnfAlphaLevel + il1BetaLevel + ifnGammaLevel;
        }

        public double getIl6Level() { return il6Level; }
        public double getTnfAlphaLevel() { return tnfAlphaLevel; }
        public double getIl1BetaLevel() { return il1BetaLevel; }
        public double getIfnGammaLevel() { return ifnGammaLevel; }
    }

    // --- SECTION 3: IMMUNOLOGICAL PHYSIOLOGY & CYTOKINE STORM CONTROLLER ---
    public static class ImmuneFeedbackController {
        private final double targetPathogenLoad; 
        private final double targetCytokineLevel; 
        private boolean feedbackActive = true;

        public ImmuneFeedbackController(double targetPathogenLoad, double targetCytokineLevel) {
            this.targetPathogenLoad = targetPathogenLoad;
            this.targetCytokineLevel = targetCytokineLevel;
        }

        public void processImmuneTelemetry(double currentPathogenLoad, CytokineNetwork cytokines) {
            if (!feedbackActive) return;
            double pathogenError = currentPathogenLoad - targetPathogenLoad;
            double totalCytokines = cytokines.getTotalProInflammatoryBurden();
            double cytokineError = totalCytokines - targetCytokineLevel;

            evaluateImmuneResponse(pathogenError, cytokineError, cytokines);
        }

        private void evaluateImmuneResponse(double pathogenError, double cytokineError, CytokineNetwork cytokines) {
            if (cytokineError > 100.0 || cytokines.getIl6Level() > 75.0) {
                dispatchEffectorSignal(
                    "CYTOKINE_STORM_ALERT_CRS", 
                    "Hypercytokinemia detected! Uncontrolled IL-6/TNF-alpha surge. Initiating emergency intervention protocols."
                );
                deployMatchedDriverInterventions(cytokines);
            } else if (pathogenError > 10.0) {
                dispatchEffectorSignal(
                    "PRO_INFLAMMATORY_SURGE", 
                    "Activate clonal expansion of T/B lymphocytes and mobilize neutrophil margination."
                );
            } else if (cytokineError > 50.0) {
                dispatchEffectorSignal(
                    "IMMUNOLOGICAL_DAMPENING_SUPPRESSION", 
                    "Deploy regulatory T-cells (Tregs) to secrete IL-10 and TGF-beta to prevent escalation."
                );
            } else {
                System.out.println("[IMMUNE HOMEOSTASIS] Surveillance active, inflammatory tone within bounds.");
            }
        }

        private void deployMatchedDriverInterventions(CytokineNetwork cytokines) {
            System.out.println("[CLINICAL INTERVENTION] Administering Corticosteroids (Dexamethasone/Methylprednisolone) for broad suppression.");
            if (cytokines.getIl6Level() > 75.0) {
                System.out.println("[TARGETED BIOLOGIC] Deploying IL-6 Receptor Antagonist (e.g., Tocilizumab) to block CRS pathway.");
            }
            if (cytokines.getIl1BetaLevel() > 50.0) {
                System.out.println("[NEURO-ESCALATION] Deploying Anakinra (IL-1 Receptor Antagonist) for blood-brain barrier penetration & ICANS mitigation.");
            }
        }

        private void dispatchEffectorSignal(String actionType, String directive) {
            System.out.println("[IMMUNE DISPATCH] Action: " + actionType + " | Directive: " + directive);
        }

        public void setFeedbackActive(boolean active) {
            this.feedbackActive = active;
        }
    }

    // --- SECTION 4: PROTECTIONARY MANAGEMENT & TISSUE MATRIX (INFLAMMATION / CONTAINMENT) ---
    public static class ImmuneTissueGrid {
        private final int width;
        private final int height;
        private final TissueState[][] grid;
        private final double[][] pathogenBurden;

        public enum TissueState {
            PRISTINE_TISSUE,
            PATHOGEN_INFECTED,
            ACTIVELY_INFLAMMED,
            CYTOKINE_STORM_DAMAGED, // Added to model hyper-inflammatory tissue destruction
            ICANS_NEURO_INFLAMMED,   // Added to model blood-brain barrier breakdown & neurotoxicity
            PROTECTION_CONTAINED,
            NECROTIC_SCAR
        }

        public ImmuneTissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new TissueState[width][height];
            this.pathogenBurden = new double[width][height];
            initializeTissue();
        }

        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = TissueState.PRISTINE_TISSUE;
                    pathogenBurden[x][y] = rand.nextDouble() * 0.05;
                }
            }
            // Introduce localized antigen/pathogen focus
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = TissueState.PATHOGEN_INFECTED;
            pathogenBurden[cx][cy] = 0.85;
        }

        public synchronized void simulateMacroStep(double immuneReactivityMultiplier, boolean stormActive) {
            TissueState[][] nextState = new TissueState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            Random rand = new Random();
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == TissueState.PATHOGEN_INFECTED || (stormActive && grid[x][y] == TissueState.ACTIVELY_INFLAMMED)) {
                        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
                        for (int[] dir : directions) {
                            int nx = x + dir[0];
                            int ny = y + dir[1];
                            if (grid[nx][ny] == TissueState.PRISTINE_TISSUE) {
                                double spreadChance = pathogenBurden[nx][ny] * immuneReactivityMultiplier;
                                if (stormActive) spreadChance *= 2.5; // Rapid runaway feedback loop
                                
                                if (rand.nextDouble() < spreadChance) {
                                    nextState[nx][ny] = stormActive ? TissueState.CYTOKINE_STORM_DAMAGED : TissueState.ACTIVELY_INFLAMMED;
                                }
                            }
                        }
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }

        public synchronized void applyProtectionaryIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if ((grid[x][y] == TissueState.PATHOGEN_INFECTED || grid[x][y] == TissueState.ACTIVELY_INFLAMMED || grid[x][y] == TissueState.CYTOKINE_STORM_DAMAGED) && intensityLevel > 0) {
                        grid[x][y] = TissueState.PROTECTION_CONTAINED;
                        intensityLevel--;
                    } else if (grid[x][y] == TissueState.PROTECTION_CONTAINED) {
                        grid[x][y] = TissueState.NECROTIC_SCAR;
                    }
                }
            }
        }
    }

    // --- SECTION 5: HIGH-FREQUENCY 6 KHZ PROCESSING & LEDGER ANCHORING ---
    public static class HighFrequencyImmuneEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;
        private final BlockingQueue<ImmuneTelemetry> telemetryQueue = new LinkedBlockingQueue<>();
        private final ImmuneTissueGrid tissueGrid;
        private final ImmuneFeedbackController feedbackController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyImmuneEngine(int gridWidth, int gridHeight, double targetPathogenLoad, double targetCytokineLevel, String besuRpcEndpoint) {
            this.tissueGrid = new ImmuneTissueGrid(gridWidth, gridHeight);
            this.feedbackController = new ImmuneFeedbackController(targetPathogenLoad, targetCytokineLevel);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestTelemetry(ImmuneTelemetry telemetry) {
            telemetryQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-Immune-Engine-V4-StormEnhanced");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) {
                processingThread.interrupt();
            }
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;
            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();
                    tickCounter++;
                    if (tickCounter % 6000 == 0) {
                        // Check if a cytokine storm is active based on recent telemetry metrics
                        boolean stormActive = false; 
                        tissueGrid.simulateMacroStep(1.02, stormActive);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            ImmuneTelemetry telemetry = telemetryQueue.poll();
            if (telemetry != null) {
                feedbackController.processImmuneTelemetry(telemetry.getPathogenLoad(), telemetry.getCytokines());
                if (telemetry.getPathogenLoad() > 75.0 || telemetry.getCytokines().getTotalProInflammatoryBurden() > 150.0) {
                    tissueGrid.applyProtectionaryIntervention(5);
                    ledgerAnchor.anchorState("CYTOKINE_STORM_CONTAINMENT_V4", telemetry.getTimestamp());
                }
            }
        }
    }

    public static class ImmuneTelemetry {
        private final long timestamp;
        private final double pathogenLoad;
        private final CytokineNetwork cytokines;
        private final double leukocyteActivityRate;

        public ImmuneTelemetry(long timestamp, double pathogenLoad, CytokineNetwork cytokines, double leukocyteActivityRate) {
            this.timestamp = timestamp;
            this.pathogenLoad = pathogenLoad;
            this.cytokines = cytokines;
            this.leukocyteActivityRate = leukocyteActivityRate;
        }

        public long getTimestamp() { return timestamp; }
        public double getPathogenLoad() { return pathogenLoad; }
        public CytokineNetwork getCytokines() { return cytokines; }
        public double getLeukocyteActivityRate() { return leukocyteActivityRate; }
    }
