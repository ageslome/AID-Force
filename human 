 private final double sympatheticLoad;
 public SensorTelemetry(long timestamp, double sympatheticLoad) {
 this.timestamp = timestamp;
 this.sympatheticLoad = sympatheticLoad;
 }
 public long getTimestamp() { return timestamp; }
 public double getSympatheticLoad() { return sympatheticLoad; }
 }
}
