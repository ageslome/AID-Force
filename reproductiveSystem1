    // --- SECTION 3: REPRODUCTIVE HORMONAL FEEDBACK CONTROLLER ---
    Public static class ReproductiveFeedbackController {
        Private final double baselineHormonalIndex;
        Private double currentGonadotropinLoad;
        Private boolean feedbackActive = true;
        Public ReproductiveFeedbackController(double baselineHormonalIndex) {
            This.baselineHormonalIndex = baselineHormonalIndex;
        }
        Public void processTelemetryStream(double latestGonadotropinLoad) {
            If (!feedbackActive) return;
            This.currentGonadotropinLoad = latestGonadotropinLoad;
            Double homeostaticError = currentGonadotropinLoad – baselineHormonalIndex;
            evaluateFeedbackLoop(homeostaticError);
        }
        Private void evaluateFeedbackLoop(double error) {
            If (error > 0.25) {
                dispatchEfferentSignal(
                    “GONADOTROPIN_SUPPRESSION”, 
                    “Inhibit GnRH/LH surge via negative feedback loop.”
                );
            } else if (error < -0.25) {
                dispatchEfferentSignal(
                    “GONADOTROPIN_STIMULATION”, 
                    “Upregulate follicular recruitment and steroidogenesis.”
                );
            } else {
                System.out.println(“[HOMEOSTASIS] Reproductive endocrine balance stable.”);
            }
        }
        Private void dispatchEfferentSignal(String actionType, String directive) {
            System.out.println(“[ENDOCRINE DISPATCH] Action: “ + actionType + “ | Directive: “ + directive);
        }
        Public void setFeedbackActive(boolean active) {
            This.feedbackActive = active;
        }
