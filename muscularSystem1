    // --- SECTION 4: MUSCULAR MALIGNANCY & TISSUE MATRIX (MYOPATHY / FIBROSIS) ---
    public static class MuscularTissueGrid {
        private final int width;
        private final int height;
        private final CellState[][] grid;
        private final double[][] degenerationFactor;

        public enum CellState {
            HEALTHY_FIBER,
            FIBROTIC_ACTIVE,
            NECROTIC_TISSUE,
            REGENERATED_FIBER
        }

        public MuscularTissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new CellState[width][height];
            this.degenerationFactor = new double[width][height];
            initializeTissue();
        }

        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = CellState.HEALTHY_FIBER;
                    degenerationFactor[x][y] = 0.10 + (rand.nextDouble() * 0.12);
                }
            }
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = CellState.FIBROTIC_ACTIVE;
            degenerationFactor[cx][cy] = 0.60;
        }

        public synchronized void simulateMacroStep(double systemicWorkloadMultiplier) {
            CellState[][] nextState = new CellState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            Random rand = new Random();
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == CellState.FIBROTIC_ACTIVE) {
                        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
                        for (int[] dir : directions) {
                            int nx = x + dir[0];
                            int ny = y + dir[1];
                            if (grid[nx][ny] == CellState.HEALTHY_FIBER) {
                                double adjustedFactor = degenerationFactor[nx][ny] * systemicWorkloadMultiplier;
                                if (rand.nextDouble() < adjustedFactor) {
                                    nextState[nx][ny] = CellState.FIBROTIC_ACTIVE;
                                }
                            }
                        }
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }

        public synchronized void applyTherapeuticIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if (grid[x][y] == CellState.FIBROTIC_ACTIVE && intensityLevel > 0) {
                        grid[x][y] = CellState.REGENERATED_FIBER;
                        intensityLevel--;
                    } else if (grid[x][y] == CellState.REGENERATED_FIBER) {
                        grid[x][y] = CellState.NECROTIC_TISSUE;
                    }
                }
            }
        }
    }

    // --- SECTION 5: HIGH-FREQUENCY 6 KHZ PROCESSING & LEDGER ANCHORING ---
    public static class HighFrequencyMuscularEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;
        
        private final BlockingQueue<MuscleSensorTelemetry> sensorQueue = new LinkedBlockingQueue<>();
        private final MuscularTissueGrid tissueGrid;
        private final ProtectionaryManagementController protectionaryController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyMuscularEngine(int gridWidth, int gridHeight, double baselineFatigue, String besuRpcEndpoint) {
            this.tissueGrid = new MuscularTissueGrid(gridWidth, gridHeight);
            this.protectionaryController = new ProtectionaryManagementController(baselineFatigue);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestSensorData(MuscleSensorTelemetry telemetry) {
            sensorQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-Muscular-Engine-V3");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) {
                processingThread.interrupt();
            }
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;
            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();
                    
                    tickCounter++;
                    if (tickCounter % 6000 == 0) {
                        tissueGrid.simulateMacroStep(1.12);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            MuscleSensorTelemetry telemetry = sensorQueue.poll();
            if (telemetry != null) {
                protectionaryController.processTelemetryStream(telemetry.getContractileStrain());
                if (telemetry.getContractileStrain() > 0.88) {
                    tissueGrid.applyTherapeuticIntervention(3);
                    ledgerAnchor.anchorState("MUSCULAR_ANOMALY_MITIGATION_V3", telemetry.getTimestamp());
                }
            }
        }
    }

    public static class MuscleSensorTelemetry {
