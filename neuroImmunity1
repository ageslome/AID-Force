    }

    // --- SECTION 4: TISSUE MATRIX & NEURO-INFLAMMATION GRID ---
    public static class NeuroImmuneTissueGrid {
        private final int width;
        private final int height;
        private final TissueState[][] grid;
        private final double[][] stressFactor;

        public enum TissueState {
            HEALTHY_NEURAL,
            TUMOR_ACTIVE,
            TUMOR_NECROTIC,
            PATHOGEN_INFECTED,
            ACTIVELY_INFLAMMED,
            CYTOKINE_STORM_DAMAGED,
            ICANS_NEURO_INFLAMMED,
            PROTECTION_CONTAINED,
            NECROTIC_SCAR
        }

        public NeuroImmuneTissueGrid(int width, int height) {
            this.width = width;
            this.height = height;
            this.grid = new TissueState[width][height];
            this.stressFactor = new double[width][height];
            initializeTissue();
        }

        private void initializeTissue() {
            Random rand = new Random();
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    grid[x][y] = TissueState.HEALTHY_NEURAL;
                    stressFactor[x][y] = 0.15 + (rand.nextDouble() * 0.10);
                }
            }
            int cx = width / 2;
            int cy = height / 2;
            grid[cx][cy] = TissueState.ICANS_NEURO_INFLAMMED;
            stressFactor[cx][cy] = 0.85;
        }

        public synchronized void simulateMacroStep(double multiplier, boolean stormActive) {
            TissueState[][] nextState = new TissueState[width][height];
            for (int x = 0; x < width; x++) {
                System.arraycopy(grid[x], 0, nextState[x], 0, height);
            }
            Random rand = new Random();
            for (int x = 1; x < width - 1; x++) {
                for (int y = 1; y < height - 1; y++) {
                    if (grid[x][y] == TissueState.ICANS_NEURO_INFLAMMED || grid[x][y] == TissueState.TUMOR_ACTIVE) {
                        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
                        for (int[] dir : directions) {
                            int nx = x + dir[0];
                            int ny = y + dir[1];
                            if (grid[nx][ny] == TissueState.HEALTHY_NEURAL) {
                                double spreadChance = stressFactor[nx][ny] * multiplier;
                                if (stormActive) spreadChance *= 2.0;
                                if (rand.nextDouble() < spreadChance) {
                                    nextState[nx][ny] = stormActive ? TissueState.ICANS_NEURO_INFLAMMED : TissueState.ACTIVELY_INFLAMMED;
                                }
                            }
                        }
                    }
                }
            }
            for (int x = 0; x < width; x++) {
                System.arraycopy(nextState[x], 0, grid[x], 0, height);
            }
        }

        public synchronized void applyTherapeuticIntervention(int intensityLevel) {
            for (int x = 0; x < width; x++) {
                for (int y = 0; y < height; y++) {
                    if ((grid[x][y] == TissueState.ICANS_NEURO_INFLAMMED || grid[x][y] == TissueState.TUMOR_ACTIVE) && intensityLevel > 0) {
                        grid[x][y] = TissueState.PROTECTION_CONTAINED;
                        intensityLevel--;
                    } else if (grid[x][y] == TissueState.PROTECTION_CONTAINED) {
                        grid[x][y] = TissueState.NECROTIC_SCAR;
                    }
                }
            }
        }
    }

    // --- SECTION 5: HIGH-FREQUENCY 6 KHZ PROCESSING & LEDGER ANCHORING ---
    public static class HighFrequencyNeuroImmuneEngine {
        private static final int TARGET_FREQUENCY_HZ = 6000;
        private static final long TICK_INTERVAL_NANOS = 1_000_000_000L / TARGET_FREQUENCY_HZ;
        
        private final BlockingQueue<NeuroImmuneTelemetry> telemetryQueue = new LinkedBlockingQueue<>();
        private final NeuroImmuneTissueGrid tissueGrid;
        private final NeuroImmuneFeedbackController feedbackController;
        private final BesuLedgerAnchor ledgerAnchor;
        private volatile boolean isRunning = false;
        private Thread processingThread;

        public HighFrequencyNeuroImmuneEngine(int gridWidth, int gridHeight, double baselineStress, double targetCytokines, String besuRpcEndpoint) {
            this.tissueGrid = new NeuroImmuneTissueGrid(gridWidth, gridHeight);
            this.feedbackController = new NeuroImmuneFeedbackController(baselineStress, targetCytokines);
            this.ledgerAnchor = new BesuLedgerAnchor(besuRpcEndpoint);
        }

        public void ingestTelemetry(NeuroImmuneTelemetry telemetry) {
            telemetryQueue.offer(telemetry);
        }

        public void startEngine() {
            isRunning = true;
            processingThread = new Thread(this::runExecutionLoop, "6kHz-NeuroImmune-Engine");
            processingThread.setPriority(Thread.MAX_PRIORITY);
            processingThread.start();
        }

        public void stopEngine() {
            isRunning = false;
            if (processingThread != null) processingThread.interrupt();
        }

        private void runExecutionLoop() {
            long nextTickTime = System.nanoTime();
            long tickCounter = 0;
            while (isRunning) {
                long now = System.nanoTime();
                if (now >= nextTickTime) {
                    executeTick();
                    tickCounter++;
                    if (tickCounter % 6000 == 0) {
                        tissueGrid.simulateMacroStep(1.05, true);
                    }
                    nextTickTime += TICK_INTERVAL_NANOS;
                } else {
                    long waitTimeNanos = nextTickTime - now;
                    if (waitTimeNanos > 50000) {
                        try {
                            Thread.sleep(waitTimeNanos / 1_000_000, (int) (waitTimeNanos % 1_000_000));
                        } catch (InterruptedException e) {
                            Thread.currentThread().interrupt();
                            break;
                        }
                    } else {
                        Thread.onSpinWait();
                    }
                }
            }
        }

        private void executeTick() {
            NeuroImmuneTelemetry telemetry = telemetryQueue.poll();
            if (telemetry != null) {
                feedbackController.processTelemetry(telemetry.getSympatheticLoad(), telemetry.getCytokines());
                if (telemetry.getSympatheticLoad() > 0.85 || telemetry.getCytokines().getIl1BetaLevel() > 50.0) {
                    tissueGrid.applyTherapeuticIntervention(5);
                    ledgerAnchor.anchorState("NEUROINFLAMMATION_ICANS_MITIGATION", telemetry.getTimestamp());
                }
            }
        }
    }

